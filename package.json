{
  "name": "equo-mvp",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm --workspace apps/web run dev",
    "build": "npm --workspace apps/web run build",
    "test": "npm --workspace apps/web run test",
    "check:encoding": "python scripts/check-encoding.py",
    "check:launch-readiness": "python scripts/check-launch-readiness-stage.py",
    "check:built-web-home": "python scripts/check-built-web-home.py",
    "smoke:production": "python scripts/smoke-production-api.py",
    "test:built-web-home": "python scripts/test-check-built-web-home.py",
    "test:smoke-web-rules": "python scripts/test-smoke-production-web.py",
    "smoke:production:web": "npm run test:smoke-web-rules && python scripts/smoke-production-web.py",
    "smoke:production:all": "npm run smoke:production:web && npm run smoke:production",
    "verify:release": "npm test && npm run build && npm run check:built-web-home && npm run check:encoding && npm run check:launch-readiness"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3"
  }
}
