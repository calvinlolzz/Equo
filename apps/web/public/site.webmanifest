{
  "name": "Equo — 記帳與分帳",
  "short_name": "Equo",
  "description": "記下自己的收支，也和朋友、室友、旅伴輕鬆分帳：自動算出誰欠誰、一鍵結清。",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#07080D",
  "theme_color": "#07080D",
  "lang": "zh-Hant",
  "categories": [
    "finance",
    "productivity",
    "utilities"
  ],
  "icons": [
    {
      "src": "/icons/equo-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "/icons/equo-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/equo-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/equo-icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/narrow.webp",
      "sizes": "780x1688",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "群組首頁：誰付了多少、誰還欠誰"
    },
    {
      "src": "/screenshots/narrow-analysis.webp",
      "sizes": "780x1688",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "分析：分類佔比，以及跟上期比多花還是少花"
    },
    {
      "src": "/screenshots/wide.webp",
      "sizes": "2560x1600",
      "type": "image/webp",
      "form_factor": "wide",
      "label": "Equo 在桌面瀏覽器上的樣子"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "receipt",
          "accept": [
            "image/*"
          ]
        }
      ]
    }
  },
  "shortcuts": [
    {
      "name": "新增支出",
      "short_name": "記一筆",
      "description": "開啟最近的群組並直接開始記帳",
      "url": "/?shortcut=add-expense"
    },
    {
      "name": "加入群組",
      "short_name": "加入",
      "description": "用邀請碼加入朋友的群組",
      "url": "/?shortcut=join"
    }
  ]
}
