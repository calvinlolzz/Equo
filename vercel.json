{
  "version": 2,
  "regions": ["sin1"],
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "apps/web/dist",
  "routes": [
    {
      "src": "/api/v1/(.*)",
      "dest": "/api/v1/[...path]"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
