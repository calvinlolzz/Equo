# Environment secrets
.env
.env.*
!.env.example
.codex/
.agents/

.vercel
.env*

# TypeScript incremental build artifact - regenerated by every build, and it
# was churning the diff of every PR.
*.tsbuildinfo

# Supabase CLI local scratch (link/dump)
supabase/.temp/

# Secrets staged for `vercel env add`. Nothing holding a live key should be one
# `git add -A` away from a public repo - and a leaked key is not fixed by a
# revert, it is fixed by rotating it. (.env* is already covered above.)
key.txt
*.key
